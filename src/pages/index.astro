---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ProjectsBento from "../components/ProjectsBento.astro";
import Publications from "../components/Publications.astro";
import Journey from "../components/Journey.astro";
import TechStack from "../components/TechStack.astro";
import Scores from "../components/Scores.astro";
import Contact from "../components/Contact.astro";
import EndfieldFlow from "../components/EndfieldFlow.astro";
import { profile } from "../data/profile";
---

<BaseLayout
  title={`${profile.name} | ${profile.canonicalTitle}`}
  description={profile.metaDescription}
>
  <EndfieldFlow>
    <Hero />
    <ProjectsBento />
    <Publications />
    <Journey />
    <TechStack />
    <Scores />
    <Contact />
  </EndfieldFlow>
</BaseLayout>
