---
import { Image } from "astro:assets";
import SectionHeading from "./SectionHeading.astro";
import { tools } from "../data/tools";
---

<section
  id="tools"
  class="portfolio-section tools-section"
  data-flow-scene
  data-flow-chapter="tools"
  data-flow-label="Side Projects / Tools"
  data-flow-code="TL-01"
  data-flow-transition="utility"
>
  <div class="section-shell">
    <SectionHeading
      index="07"
      eyebrow="Side Projects / Tools"
      title="Small tools, on the side."
      description="Lightweight utilities I build when the one I need doesn't exist. They run in the browser and collect nothing. They sit outside my AI engineering work, but I build them with the same care."
    />

    <div class="tools-grid">
      {tools.map((tool, index) => (
        <article class="tool-card" data-reveal>
          <div class="tool-card-body">
            <div class="tool-card-top"><span>TOOL / {String(index + 1).padStart(2, "0")}</span><span>LIVE</span></div>
            <h3>{tool.name}</h3>
            <p>{tool.description}</p>
            <ul class="tool-tags">
              {tool.tags.map((tag) => <li>{tag}</li>)}
            </ul>
            <div class="tool-card-links">
              <a href={tool.href} data-astro-reload>Open tool <span>↗</span></a>
              <a href={tool.sourceHref} target="_blank" rel="noopener">Source <span>↗</span></a>
            </div>
          </div>
          <a class="tool-card-preview" href={tool.href} data-astro-reload tabindex="-1" aria-hidden="true">
            <Image src={tool.preview} alt="" widths={[640, 960, 1280]} sizes="(min-width: 62rem) 55vw, 100vw" loading="lazy" />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
