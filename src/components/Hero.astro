---
import { Image } from "astro:assets";
import portrait from "../assets/images/portrait-cutout-v2.png";
import { publications } from "../data/publications";
import { profile } from "../data/profile";
import KineticMarquee from "./KineticMarquee.astro";

const year = new Date().getFullYear();
---

<section
  id="hero"
  class="hero-section"
  data-flow-scene
  data-flow-chapter="hero"
  data-flow-label="Identity"
  data-flow-code="ID-00"
  data-flow-transition="identity"
>
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-instrument hero-instrument--asset" aria-hidden="true">
    <span>BASED IN</span>
    <strong>JAKARTA / INDONESIA</strong>
  </div>
  <div class="hero-instrument hero-instrument--base" aria-hidden="true">
    <span>LOCAL BASE</span>
    <strong>JAKARTA / ID</strong>
  </div>

  <div class="hero-topline" data-flow-panel="metadata">
    <p data-hero-reveal>PORTFOLIO / {year}</p>
    <p data-hero-reveal>{profile.canonicalTitle.toUpperCase()} / APPLIED AI</p>
    <p data-hero-reveal>OPEN TO OPPORTUNITIES <span class="status-dot"></span></p>
  </div>

  <div class="hero-title" aria-label="Shafri Syamsuddin" data-flow-panel="title">
    <h1 data-flow-title>
      <span class="hero-title-line hero-title-line--first"><span data-hero-reveal>SHAFRI</span></span>
      <span class="hero-title-line hero-title-line--second"><span data-hero-reveal>SYAMSUDDIN</span></span>
    </h1>
  </div>

  <div class="hero-image-zone" data-flow-panel="subject">
    <div class="hero-image-yellow" aria-hidden="true"></div>
    <div class="hero-image-frame">
      <div class="hero-image-subject">
        <Image
          src={portrait}
          alt="Portrait of M Shafri Syamsuddin"
          width={800}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          data-loader-image
          data-loader-hero
        />
      </div>
      <div class="hero-image-scan" aria-hidden="true"></div>
    </div>
    <span class="hero-image-label" aria-hidden="true">M SHAFRI SYAMSUDDIN</span>
  </div>

  <div class="hero-role" data-hero-reveal data-flow-panel="stats">
    <div class="hero-dossier-header">
      <span>ASSISTX ENTERPRISE / JAN 2026—PRESENT</span>
      <b>JAKARTA / ID</b>
    </div>

    <div class="hero-dossier-primary">
      <strong>{profile.canonicalTitle}</strong>
      <div class="hero-dossier-copy">
        <p>{profile.summary}</p>
        <p class="hero-focus-line">{profile.primaryFocus}</p>
        <p class="hero-supporting-focus">{profile.supportingFocus}</p>
      </div>
    </div>

    <div class="hero-evidence" aria-label="Selected engineering and research evidence">
      <a class="hero-proof" href="/projects/enterprise-ai-platform">
        <span>CURRENT WORK</span>
        <strong>AssistX Suite <small>My engineering contribution</small></strong>
        <b aria-hidden="true">↗</b>
      </a>
      <a
        class="hero-proof"
        href={publications[0]?.linkHref}
        target="_blank"
        rel="noopener"
        aria-label={`Read ${publications[0]?.title ?? "IEEE publication"}`}
      >
        <span>IEEE / {publications[0]?.year ?? "2025"}</span>
        <strong>Published research <small>Malaria detection · AMLDS 2025</small></strong>
        <b aria-hidden="true">↗</b>
      </a>
    </div>
  </div>

  <div class="hero-actions" data-hero-reveal data-flow-panel="actions">
    <a href="/projects" class="action-button action-button--dark"><span>Explore work</span><b>↗</b></a>
    <a href="/docs/m-shafri-syamsuddin-cv.pdf" target="_blank" rel="noopener" class="action-button"><span>View CV</span><b>↗</b></a>
    <a href="mailto:shafrisyamsuddin@gmail.com" class="text-action">LET’S TALK <b>↗</b></a>
  </div>

  <a href="/#projects" class="hero-scroll" data-nav-section="projects" aria-label="Scroll to case studies">
    <span>SCROLL TO EXPLORE</span><i>↓</i>
  </a>
</section>

<KineticMarquee text="AI SYSTEMS / VISION / LANGUAGE / DEPLOY" />
