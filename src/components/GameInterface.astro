---
import { getImage, Image } from "astro:assets";
import { getCollection } from "astro:content";
import portrait from "../assets/images/portrait-cutout-v2.png";
import { journey } from "../data/journey";
import { publications } from "../data/publications";
import { scores } from "../data/scores";
import { socials } from "../data/socials";
import { techStack } from "../data/techStack";
import "../styles/game-interface.css";
import ContactForm from "./ContactForm";

const projects = (await getCollection("projects"))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const portraitWebgl = await getImage({ src: portrait, width: 800, format: "webp" });

const modules = [
  { key: "projects", code: "OP-01", index: "01", eyebrow: "OPERATIONS", label: "Case Studies", note: `${projects.length} FILES`, size: "major" },
  { key: "profile", code: "PR-02", index: "02", eyebrow: "PERSONNEL", label: "Operator File", note: `${journey.length} RECORDS`, size: "wide" },
  { key: "records", code: "RC-03", index: "03", eyebrow: "ARCHIVE", label: "Research", note: `${publications.length} ITEMS`, size: "standard" },
  { key: "modules", code: "MD-04", index: "04", eyebrow: "LOADOUT", label: "Capabilities", note: `${techStack.length} GROUPS`, size: "standard" },
  { key: "assessment", code: "AS-05", index: "05", eyebrow: "EVALUATION", label: "Assessment", note: `${scores.length} REPORTS`, size: "standard" },
  { key: "recruitment", code: "CT-06", index: "06", eyebrow: "CHANNEL", label: "Recruitment", note: "OPEN", size: "signal" },
];

const pad = (value: number) => String(value).padStart(2, "0");
---

<div class="game-ui" data-game-ui data-active-screen="home">
  <canvas
    class="game-scene-canvas"
    data-game-canvas
    data-portrait-src={portraitWebgl.src}
    aria-hidden="true"
  ></canvas>

  <div class="game-scene-fallback" aria-hidden="true">
    <span class="game-fallback-slab"></span>
    <Image
      src={portrait}
      alt=""
      width={800}
      loading="eager"
      fetchpriority="high"
      data-loader-image
      data-loader-hero
    />
  </div>

  <div class="game-world-grid" aria-hidden="true"></div>
  <div class="game-world-scan" aria-hidden="true"></div>
  <div class="game-corner game-corner--tl" aria-hidden="true"></div>
  <div class="game-corner game-corner--br" aria-hidden="true"></div>

  <header class="game-topbar">
    <button type="button" class="game-brand" data-game-target="home" aria-label="Return to home screen">
      <span class="game-brand-mark">MS</span>
      <span><strong>PERSONNEL CONTROL</strong><small>PORTFOLIO SYSTEM // 2026</small></span>
    </button>

    <div class="game-top-status" aria-label="System status">
      <span><i></i> ONLINE</span>
      <span>JKT / UTC+07</span>
      <time data-game-clock>--:--:--</time>
    </div>

    <div class="game-system-controls">
      <button type="button" class="game-quality" data-game-quality aria-pressed="true">
        <small>RENDER</small><span data-game-quality-label>HIGH</span>
      </button>
      <button
        type="button"
        class="sound-toggle game-sound-toggle"
        data-sound-toggle
        data-sound-enabled="true"
        aria-pressed="true"
        aria-label="Mute interface sounds"
        title="Mute interface sounds"
      >
        <span class="sound-toggle-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square">
            <path d="M4 10h4l4-4v12l-4-4H4z"></path>
            <path class="sound-toggle-wave" d="M15 9.2c1.4 1.5 1.4 4.1 0 5.6M18 6.5c3 3 3 8 0 11"></path>
            <path class="sound-toggle-slash" d="m5 5 14 14"></path>
          </svg>
        </span>
        <span data-sound-toggle-label>SFX ON</span>
      </button>
    </div>
  </header>

  <div class="game-screen-stack">
    <section id="hero" class="game-screen game-screen--home is-active" data-game-screen="home">
      <div class="game-home-identity">
        <p class="game-overline"><span>SELECTED OPERATOR</span><b>01 / 01</b></p>
        <h1><span>SHAFRI</span><span>SYAMSUDDIN</span></h1>
        <div class="game-identity-code">
          <strong>MSS-001</strong>
          <span>AI ENGINEER / SPECIALIST</span>
        </div>
        <p class="game-identity-copy">Building production-aware computer vision and language systems from research to deployment.</p>
        <div class="game-identity-tags" aria-label="Specializations">
          <span>COMPUTER VISION</span><span>NLP</span><span>MLOPS</span>
        </div>
      </div>

      <div class="game-subject-readout" aria-hidden="true">
        <span>SUBJECT LOCK // MSS-001</span>
        <i></i>
        <span>DEPTH FEED / ACTIVE</span>
      </div>

      <nav class="game-module-grid" aria-label="Portfolio modules">
        {modules.map((module) => (
          <button
            type="button"
            class:list={["game-module", `game-module--${module.size}`]}
            data-game-target={module.key}
          >
            <span class="game-module-index">{module.index}</span>
            <span class="game-module-copy"><small>{module.eyebrow}</small><strong>{module.label}</strong></span>
            <span class="game-module-note">{module.note}</span>
            <i aria-hidden="true">↗</i>
          </button>
        ))}
      </nav>

      <div class="game-dialogue">
        <span class="game-dialogue-avatar">MS</span>
        <p><small>OPERATOR MESSAGE</small>Ready to review the file? Select a module to begin the assessment.</p>
      </div>
    </section>

    <section id="projects" class="game-screen game-screen--module" data-game-screen="projects">
      <header class="game-screen-header" tabindex="-1">
        <button type="button" class="game-back" data-game-target="home"><span>←</span> HOME</button>
        <div><small>OPERATIONS // CASE STUDY ARCHIVE</small><h2>SELECT OPERATION</h2></div>
        <p>Choose a deployment record to inspect its role, system architecture and measured outcome.</p>
        <strong>OP-01</strong>
      </header>

      <div class="game-project-layout">
        <nav class="game-project-roster" aria-label="Case study roster">
          {projects.map((project, index) => (
            <button type="button" class:list={["game-project-select", index === 0 && "is-selected"]} data-project-select={index}>
              <span class="game-project-thumb"><Image src={project.data.heroImage} alt="" width={320} loading="eager" /></span>
              <span><small>OP-{pad(index + 1)}</small><strong>{project.data.title}</strong><em>{project.data.eyebrow}</em></span>
              <i>{pad(index + 1)}</i>
            </button>
          ))}
        </nav>

        <div class="game-project-records">
          {projects.map((project, index) => (
            <article class:list={["game-project-record", index === 0 && "is-selected"]} data-project-record={index}>
              <div class="game-project-visual">
                <Image
                  src={project.data.heroImage}
                  alt={project.data.heroImageAlt}
                  width={1200}
                  loading="eager"
                  data-loader-image
                />
                <span class="game-visual-grid" aria-hidden="true"></span>
                <b>VISUAL FEED // {pad(index + 1)}</b>
              </div>
              <div class="game-project-data">
                <p class="game-record-kicker"><span>SELECTED RECORD</span><b>{project.data.eyebrow}</b></p>
                <h3>{project.data.title}</h3>
                <p>{project.data.summary}</p>
                <dl class="game-stat-grid">
                  {project.data.metrics.map((metric, metricIndex) => (
                    <div><dt>{pad(metricIndex + 1)} / {metric.label}</dt><dd>{metric.value}</dd></div>
                  ))}
                </dl>
                <div class="game-record-actions">
                  <a href={`/projects/${project.id}`} class="game-primary-action"><span>OPEN FULL RECORD</span><b>↗</b></a>
                  {project.data.links[0] && <a href={project.data.links[0].href} target="_blank" rel="noopener">SOURCE ↗</a>}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="journey" class="game-screen game-screen--module" data-game-screen="profile">
      <header class="game-screen-header" tabindex="-1">
        <button type="button" class="game-back" data-game-target="home"><span>←</span> HOME</button>
        <div><small>PERSONNEL // OPERATOR RECORD</small><h2>OPERATOR FILE</h2></div>
        <p>Education, professional assignments and leadership records arranged as one verified chronology.</p>
        <strong>PR-02</strong>
      </header>

      <div class="game-profile-layout">
        <aside class="game-profile-summary">
          <span class="game-profile-number">001</span>
          <div><small>DESIGNATION</small><strong>AI ENGINEER</strong></div>
          <dl>
            <div><dt>BASE</dt><dd>JAKARTA / ID</dd></div>
            <div><dt>FOCUS</dt><dd>VISION + LANGUAGE</dd></div>
            <div><dt>STATUS</dt><dd>AVAILABLE</dd></div>
            <div><dt>EDUCATION</dt><dd>M.CS / B.ENG</dd></div>
          </dl>
          <a href="/docs/m-shafri-syamsuddin-cv.pdf" target="_blank" rel="noopener" class="game-primary-action"><span>OPEN RÉSUMÉ</span><b>↗</b></a>
        </aside>

        <ol class="game-timeline">
          {journey.map((entry, index) => (
            <li>
              <span>{pad(index + 1)}</span>
              <div><small>{entry.period} // {entry.kind}</small><h3>{entry.title}</h3><p>{entry.description}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="publications" class="game-screen game-screen--module" data-game-screen="records">
      <header class="game-screen-header" tabindex="-1">
        <button type="button" class="game-back" data-game-target="home"><span>←</span> HOME</button>
        <div><small>ARCHIVE // VERIFIED OUTPUT</small><h2>RESEARCH RECORDS</h2></div>
        <p>Published research and supporting conference documentation from applied medical computer vision work.</p>
        <strong>RC-03</strong>
      </header>

      <div class="game-record-grid">
        {publications.map((publication, index) => (
          <article class="game-publication-record">
            <a href={publication.linkHref} target={publication.linkHref.startsWith("http") ? "_blank" : undefined} rel="noopener">
              <span class="game-publication-image">
                <img src={publication.image} alt={`Preview for ${publication.title}`} loading="eager" data-loader-image />
                <i class="game-visual-grid" aria-hidden="true"></i>
              </span>
              <span class="game-publication-copy">
                <small>RC-{pad(index + 1)} // {publication.kind}</small>
                <strong>{publication.title}</strong>
                <p>{publication.description}</p>
                <b>{publication.source} / {publication.year} / {publication.status}</b>
                <em>{publication.linkLabel} ↗</em>
              </span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section id="tech-stack" class="game-screen game-screen--module" data-game-screen="modules">
      <header class="game-screen-header" tabindex="-1">
        <button type="button" class="game-back" data-game-target="home"><span>←</span> HOME</button>
        <div><small>LOADOUT // TECHNICAL CAPABILITY</small><h2>MODULE CONFIGURATION</h2></div>
        <p>Tools grouped by how they contribute to model development, deployment, analytics and product delivery.</p>
        <strong>MD-04</strong>
      </header>

      <div class="game-loadout-grid">
        {techStack.map((category, categoryIndex) => (
          <article class="game-loadout-group">
            <header><span>{pad(categoryIndex + 1)}</span><div><small>{category.domain}</small><h3>{category.title}</h3></div><b>{category.status}</b></header>
            <ul>
              {category.items.map((item, itemIndex) => (
                <li><img src={`/icons/${item.icon}`} alt="" /><span>{item.name}</span><small>{pad(itemIndex + 1)}</small></li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section id="scores" class="game-screen game-screen--module" data-game-screen="assessment">
      <header class="game-screen-header" tabindex="-1">
        <button type="button" class="game-back" data-game-target="home"><span>←</span> HOME</button>
        <div><small>EVALUATION // VERIFIED SCORES</small><h2>ASSESSMENT DATA</h2></div>
        <p>External assessment records presented as operator attributes with their original reports attached.</p>
        <strong>AS-05</strong>
      </header>

      <div class="game-assessment-layout">
        {scores.map((score, index) => (
          <a href={score.reportHref} target="_blank" rel="noopener" class="game-score-card">
            <span class="game-score-index">{pad(index + 1)}</span>
            <div><small>{score.issuer}</small><h3>{score.name}</h3><p>{score.issuedAt}</p></div>
            <strong>{score.value}</strong>
            <i>VERIFIED REPORT ↗</i>
          </a>
        ))}
        <aside class="game-assessment-note">
          <small>ASSESSMENT SUMMARY</small>
          <strong>COMMUNICATION<br />+ APTITUDE</strong>
          <p>Supporting evidence is available directly from each verified report.</p>
          <span>FILE INTEGRITY // CONFIRMED</span>
        </aside>
      </div>
    </section>

    <section id="contact" class="game-screen game-screen--module" data-game-screen="recruitment">
      <header class="game-screen-header" tabindex="-1">
        <button type="button" class="game-back" data-game-target="home"><span>←</span> HOME</button>
        <div><small>CHANNEL // RECRUITMENT UPLINK</small><h2>OPEN A CHANNEL</h2></div>
        <p>Send a project brief, role or collaboration proposal through the secure contact endpoint.</p>
        <strong>CT-06</strong>
      </header>

      <div class="game-contact-layout">
        <div class="game-contact-intro">
          <p class="game-record-kicker"><span>OPERATOR STATUS</span><b>AVAILABLE</b></p>
          <h3>LET'S BUILD<br />SOMETHING<br /><em>USEFUL.</em></h3>
          <a href="mailto:shafrisyamsuddin@gmail.com" class="game-contact-email">SHAFRISYAMSUDDIN@GMAIL.COM <span>↗</span></a>
          <nav aria-label="Social links">
            {socials.map((social, index) => <a href={social.href} target="_blank" rel="noopener"><small>{pad(index + 1)}</small>{social.label}<span>↗</span></a>)}
          </nav>
        </div>
        <div class="game-contact-form">
          <header><span>SECURE MESSAGE FORM</span><span>TLS // ACTIVE</span></header>
          <ContactForm client:load />
        </div>
      </div>
    </section>
  </div>

  <nav class="game-dock" aria-label="Quick navigation">
    <button type="button" data-game-target="home" class="is-active"><small>00</small><span>HOME</span></button>
    {modules.map((module) => (
      <button type="button" data-game-target={module.key}><small>{module.index}</small><span>{module.eyebrow}</span></button>
    ))}
    <a href="/docs/m-shafri-syamsuddin-cv.pdf" target="_blank" rel="noopener"><small>07</small><span>RÉSUMÉ ↗</span></a>
  </nav>

  <p class="sr-only" aria-live="polite" aria-atomic="true" data-game-announcer></p>
</div>
